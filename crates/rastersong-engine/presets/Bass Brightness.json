      ],
      "size": [
        400,
        300
      ],
      "description": "The bass level moves Brightness."
    },
    {
      "id": "video",
      "type": "video_input",
      "position": [
        440,
        130
      ]
    },
    {
      "id": "brightness",
      "type": "offset",
      "position": [
        630,
        0
      ],

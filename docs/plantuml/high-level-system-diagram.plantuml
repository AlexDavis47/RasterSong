@startuml
!theme plain
skinparam packageStyle rectangle
skinparam rectangle {
    BackgroundColor LightBlue
}

title RasterSong System Overview (Updated Engine Architecture)

left to right direction

actor User

' ============================================
' INPUT STAGE
' ============================================
package "Input Sources" #LightYellow {
    rectangle "Video File" as video_file
    rectangle "Audio File" as audio_file
}

User --> video_file
User --> audio_file

' ============================================
' DECODING STAGE
' ============================================
package "Decoding" #LightGreen {
    component "Video\nDecoder" as video_decoder
    component "Audio\nDecoder" as audio_decoder
}

video_file --> video_decoder
audio_file --> audio_decoder

rectangle "Carrier Signals\n(Red, Green, Blue, Alpha)\n(32-bit float)" as carriers #LightCyan
rectangle "Embedded Audio" as embedded_audio #LightCyan
rectangle "Modulator Signal\n(32-bit float)" as modulator #LightCyan

video_decoder --> carriers
video_decoder --> embedded_audio
embedded_audio --> audio_decoder
audio_decoder --> modulator

' ============================================
' RESAMPLING & TIMELINE NORMALIZATION
' ============================================
package "Preprocessing" #LightGray {
    rectangle "Modulator Resampler\n(aligns modulators to carrier timeline)" as resampler
    rectangle "Carrier Timeline\n(Base sample rate = video decode rate)" as timeline
}

modulator --> resampler
carriers --> timeline
resampler --> timeline

' ============================================
' ENGINE CORE
' ============================================
package "Audio-Video Engine" #LightPink {
    rectangle "Graph Scheduler\n(orders nodes, manages latency, lookahead, feedback)" as scheduler
    rectangle "Node Processor\n(32-bit float DSP operations)" as processor
    rectangle "State Manager\n(stores node states, delay buffers, feedback)" as state_manager
    rectangle "Cache Manager\n(pre-renders & stores recent/future frames)" as cache_manager
    rectangle "Continuous Engine Loop\n(runs background pre-rendering)" as engine_loop
}

timeline --> scheduler
scheduler --> processor
processor --> state_manager
processor --> cache_manager
state_manager --> scheduler
engine_loop --> cache_manager
engine_loop --> scheduler

note bottom of scheduler
  • Resolves node dependencies
  • Aligns carrier/modulator latency
  • Expands temporal margins
end note

note right of state_manager
  • Maintains delay & feedback buffers
  • Handles backprocessing for state reconstruction
end note

note right of cache_manager
  • Predictive pre-rendering
  • Invalidates regions on node change
  • Shares data between preview & export
end note

' ============================================
' EFFECTS GRAPH
' ============================================
package "Graph Nodes" #LightCoral {
    rectangle "Input Nodes\n(Carriers + Modulators)" as input_nodes
    rectangle "Three-Band\nSplitter" as splitter
    rectangle "AM Modulation\nNodes" as am_nodes
    rectangle "Effect Nodes\n(Sample Delay, Bit Crush, LPF, etc.)" as effect_nodes
    rectangle "Output Nodes" as output_nodes
}

scheduler --> input_nodes
input_nodes --> splitter
splitter --> am_nodes
input_nodes --> am_nodes
am_nodes --> effect_nodes
effect_nodes --> output_nodes
output_nodes --> processor

' ============================================
' ENCODING STAGE
' ============================================
package "Encoding" #LightGreen {
    component "Video Encoder\n(normalize to bit depth, pack pixels)" as video_encoder
}

cache_manager --> video_encoder
video_encoder --> User : "Preview / Export"

' ============================================
' OUTPUT STAGE
' ============================================
package "Output" #LightYellow {
    rectangle "Output Video File" as output_video
}

video_encoder --> output_video
output_video --> User

@enduml

@startuml
!theme plain
skinparam packageStyle rectangle
skinparam rectangle {
    BackgroundColor LightBlue
}

title RasterSong System Architecture (Frame-Based Timeline with Sample-Stream Processing)

top to bottom direction

actor User

' ============================================
' INPUT STAGE
' ============================================
package "Input Sources" #LightYellow {
    rectangle "Video File\n(frames)" as video_file
    rectangle "Audio File\n(44.1kHz)" as audio_file
}

User --> video_file
User --> audio_file

' ============================================
' DECODING & UP-FRONT RESAMPLING
' ============================================
package "Decoding & Preprocessing" #LightGreen {
    component "Video Decoder\n(decode to frames)" as video_decoder
    component "Audio Decoder" as audio_decoder
    component "Up-Front Resampler\n(modulator → carrier rate)\nHigh-quality, once on load" as upfront_resampler
}

video_file --> video_decoder
audio_file --> audio_decoder
audio_decoder --> upfront_resampler

note left of upfront_resampler
  • Resamples modulator to carrier rate
  • Highest quality (polyphase/sinc)
  • Eliminates multi-rate issues
end note

rectangle "Raw Video Frames\n(frame packages)" as raw_frames #LightCyan
rectangle "Resampled Modulator\n(at carrier rate)\n(32-bit float)" as resampled_mod #LightCyan

video_decoder --> raw_frames
upfront_resampler --> resampled_mod

' ============================================
' FRAME-BASED TIMELINE
' ============================================
package "Timeline Manager" #Wheat {
    rectangle "Frame-Based Timeline\n(UI timeline, scrubbing)\nTimeline unit = frame index" as timeline
    rectangle "Playhead Position\n(current frame)" as playhead
}

raw_frames --> timeline
resampled_mod --> timeline
User --> playhead
playhead --> timeline

' ============================================
' EFFECT GRAPH (PULL-BASED)
' ============================================
package "Effect Graph (Pull-Based Evaluation)" #LightCoral {
    rectangle "Input Nodes" as input_nodes {
        rectangle "FrameDecoder\n(frame → channel streams)" as frame_decoder
        rectangle "Modulator Input" as mod_input
    }
    
    rectangle "Format Converters" as format_nodes {
        rectangle "ToInterleaved" as to_interleaved
        rectangle "ChannelSplitter" as splitter
        rectangle "ChannelMerger" as merger
    }
    
    rectangle "Effect Nodes" as effect_nodes {
        rectangle "Three-Band\nSplitter" as three_band
        rectangle "AM Modulation" as am_node
        rectangle "Delay (stateful)" as delay_node
        rectangle "Bit Crush" as bitcrush
        rectangle "Filters (LPF)" as filter_node
    }
    
    rectangle "Output Node\n(pulls from graph)" as output_node
}

timeline --> frame_decoder : "provides frames"
timeline --> mod_input : "provides modulator"

frame_decoder --> format_nodes
mod_input --> effect_nodes
format_nodes --> effect_nodes
effect_nodes --> output_node

note bottom of output_node
  • Pull-based: requests frame N
  • Converts to sample range [S, S+len]
  • Recursively pulls with lookback/lookahead
end note

note bottom of effect_nodes
  • Nodes declare lookback/lookahead/latency
  • Stateful nodes process ALL samples (incl. padding)
  • Support multiple block formats
end note

' ============================================
' PROCESSING ENGINE
' ============================================
package "Always-Running Processing Engine" #LightPink {
    rectangle "Background Render Thread\n(continuously pre-renders)" as render_thread
    rectangle "State Manager" as state_mgr {
        rectangle "Node State\n(delay buffers, etc.)" as node_state
        rectangle "State Warmup\n(on seek: process from N-K)" as warmup
        rectangle "State Snapshots\n(optional: periodic saves)" as snapshots
    }
    
    rectangle "Frame Cache with Validity Tracking" as cache {
        rectangle "Cached Frames\n+ state_hash\n+ computed_with_state_from" as cached_frames
        rectangle "Cache Invalidation\n(on graph change or seek)" as invalidation
    }
}

output_node --> render_thread : "graph evaluation"
render_thread --> state_mgr
render_thread --> cache
state_mgr --> effect_nodes : "provides/updates state"

note right of warmup
  • On seek to frame N: process from N-K
  • K = max lookback of stateful nodes
  • First K frames marked "warming up"
end note

note right of cached_frames
  • Valid only with correct state lineage
  • Seek breaks continuity → invalidate
  • Effect changes → invalidate forward
end note

' ============================================
' DYNAMIC PLAYBACK CONTROLLER
' ============================================
package "Dynamic Playback System" #Lavender {
    rectangle "Buffer Depth Monitor\n(distance to furthest cached frame)" as buffer_monitor
    rectangle "Playback Speed Calculator\nspeed = min(buffer_distance_sec, 1.0)" as speed_calc
}

cache --> buffer_monitor
buffer_monitor --> speed_calc
speed_calc --> playhead : "controls playback rate"
render_thread --> cache : "always processes at full speed"

note bottom of speed_calc
  • 1.0s+ buffered = 1.0x speed
  • 0.5s buffered = 0.5x speed
  • 0s buffered = 0x (paused)
  • Self-regulating: playback adapts to rendering
end note

note right of render_thread
  • Always runs at full speed
  • Continuously builds cache forward
  • No priority adjustments
end note

' ============================================
' OUTPUT
' ============================================
package "Output" #LightGreen {
    rectangle "Preview Display\n(shows current frame)" as preview
    rectangle "Export Encoder\n(same graph, max speed)" as export
}

cache --> preview
cache --> export
preview --> User
export --> User : "Final Video"

' ============================================
' UI FEEDBACK
' ============================================
package "UI Indicators" #LightYellow {
    rectangle "Playback speed %\nBuffer depth (seconds)\nWarmup indicator" as ui_feedback
}

speed_calc --> ui_feedback
warmup --> ui_feedback
ui_feedback --> User

@enduml

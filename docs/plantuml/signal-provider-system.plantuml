@startuml
!theme plain
allow_mixing

title Signal Provider System - Component API

' ============================================
' PUBLIC API
' ============================================
interface "SignalProviderAPI" as api {
  + new() -> SignalProvider
  + set_video(video: VideoFile) -> Result<Vec<ChannelId>>
  + add_audio(name: String, audio: AudioFile) -> Result<AudioFileId>
  + remove_audio(id: AudioFileId) -> Result<()>
  + list_audio_files() -> Vec<AudioFileInfo>
  + list_channels() -> Vec<ChannelInfo>
  + get_frame_data(frame_index: usize) -> Option<FrameData>
  + frame_count() -> Option<usize>
  + sample_rate() -> Option<f64>
}

note right of api
  **Public Interface**
  Unified channel-based signal access:
  
  **Setup:**
  • Create empty SignalProvider
  • set_video() → returns 3 ChannelIds (Red, Green, Blue)
  • add_audio() → returns AudioFileId, creates 1+ ChannelId(s)
  • remove_audio() removes file and its channels
  
  **Query:**
  • list_channels() → all available signal channels
  • list_audio_files() → loaded audio files with their channels
  
  **Access:**
  • get_frame_data(N) → HashMap of all channels
  • Each channel is just: id, name, source, samples
  • No distinction between carriers and modulators!
  
  This is where file data becomes actual signals!
end note

' ============================================
' OUTPUT DATA STRUCTURE
' ============================================
package "Output Data Structure" #LightYellow {
    class FrameData {
        + frame_index: usize
        + channels: HashMap<ChannelId, SignalChannel>
        + sample_count: usize
        + get_channel(id: ChannelId) -> Option<SignalChannel>
        + get_channel_by_name(name: &str) -> Option<SignalChannel>
    }
    
    class SignalChannel {
        + id: ChannelId
        + name: String
        + source: ChannelSource
        + samples: Vec<f32>
    }
    
    enum ChannelSource {
        VideoRed
        VideoGreen
        VideoBlue
        AudioFile(AudioFileId)
    }
    
    class ChannelId {
        + uuid: Uuid
    }
    
    class AudioFileId {
        + uuid: Uuid
    }
    
    class AudioFileInfo {
        + id: AudioFileId
        + name: String
        + channel_ids: Vec<ChannelId>
        + duration_seconds: f64
        + original_sample_rate: f64
    }
    
    class ChannelInfo {
        + id: ChannelId
        + name: String
        + source: ChannelSource
    }
}

FrameData --> SignalChannel
SignalChannel --> ChannelId
SignalChannel --> ChannelSource
ChannelSource --> AudioFileId
AudioFileInfo --> AudioFileId
AudioFileInfo --> ChannelId
ChannelInfo --> ChannelId
ChannelInfo --> ChannelSource

api ..> FrameData : "get_frame_data returns"
api ..> AudioFileInfo : "list_audio_files returns"
api ..> ChannelInfo : "list_channels returns"
api ..> AudioFileId : "add_audio returns"
api ..> ChannelId : "set_video returns"

note bottom of FrameData
  **Unified Signal Channels:**
  
  All channels at the same sample rate!
  • Video provides 3 channels: "Red", "Green", "Blue"
  • Each audio file provides 1+ channels (mono/stereo)
  • All channels have same sample count per frame
  
  Example @ 240×180:
  • sample_count = 43,200
  • channels["Red"].samples = Vec<f32> of 43,200 values
  • channels["Bass"].samples = Vec<f32> of 43,200 values
  
  **Important:** When video changes, sample rate changes!
  All audio channels automatically re-interpolate.
  
  **Treat all channels uniformly** - they're just signals!
end note

' ============================================
' INPUTS (from other systems)
' ============================================
package "Input Dependencies" #LightCyan {
    rectangle "VideoFile\n(from Input/Preprocessing)" as video_file
    rectangle "AudioFile(s)\n(from Input/Preprocessing)" as audio_files
}

video_file --> api : "provided on init"
audio_files --> api : "provided on init"

note bottom of video_file
  From Input/Preprocessing system:
  • Compressed frames (not signals yet!)
  • decode_frame(index) method
  • Video metadata
end note

note bottom of audio_files
  From Input/Preprocessing system:
  • Original sample rate (44kHz, not carrier rate!)
  • Raw PCM samples (mono or stereo)
  • Audio metadata
  
  **Note:** Stereo files create 2 channels,
  mono files create 1 channel.
end note

' ============================================
' INTERNAL IMPLEMENTATION
' ============================================
package "Internal Implementation" #LightBlue {
    component "Frame Decoder" as frame_decoder
    component "Pixel to Sample Converter" as pixel_converter
    component "Linear Interpolator" as interpolator
    component "Sample Buffer Manager" as buffer_mgr
}

note top of frame_decoder
  **Frame Decoding:**
  • Decompress frame on-demand
  • PNG/JPEG-LS decompression
  • Returns raw RGB pixels
  • Cache recent frames (LRU)
end note

note top of pixel_converter
  **Pixel → Sample Conversion:**
  • Unravel frame pixels row-by-row
  • Separate into R, G, B channels
  • Convert u8 (0-255) → f32 (0.0-1.0)
  • Each channel = Vec<f32> of size width×height
end note

note top of interpolator
  **Audio Interpolation:**
  • Linear interpolation in real-time
  • From original rate (44.1kHz) → carrier rate
  • Per-frame sample range calculation
  • Fast and memory-efficient
  
  Example:
  Frame N at carrier rate:
  start_sample = N × samples_per_frame
  Map back to original audio indices
  Interpolate to fill samples_per_frame values
end note

note top of buffer_mgr
  **Buffer Management:**
  • Reusable Vec<f32> pools
  • Reduces allocations
  • Pre-allocated buffers
end note

' ============================================
' PROCESSING FLOW
' ============================================
note left of api
  **Processing Flow for Frame N:**
  
  1. get_frame_data(N) called
     - Returns None if no video loaded
  
  2. Decode video frame N:
     - Decompress from VideoFile
     - Convert pixels → 3 signal channels (R, G, B)
  
  3. For each added audio file:
     - Calculate sample range for frame N
     - Linear interp from 44kHz → sample rate
     - Fill signal channel(s) with ID + name
  
  4. Return FrameData with all channels
  
  **Performance (240×180):**
  • Frame decode: ~0.5-2ms
  • Pixel conversion: ~0.1ms
  • Audio interp per channel: ~0.2ms
  • Total: ~1-3ms + 0.2ms per audio channel
  
  **Example Usage:**
  ```rust
  let mut provider = SignalProvider::new();
  
  // Load video, get its 3 channel IDs
  let [red_id, green_id, blue_id] = provider.set_video(video_file)?;
  
  // Add audio files
  let bass_file = provider.add_audio("Bass", bass_audio)?;
  let drums_file = provider.add_audio("Drums", drums_audio)?;
  
  // Get all channels for frame 42
  let frame = provider.get_frame_data(42)?;
  
  // Access any channel by ID or name
  let red_signal = frame.get_channel(red_id)?;
  let bass_signal = frame.get_channel_by_name("Bass")?;
  
  // All channels are identical type!
  for (id, channel) in &frame.channels {
      println!("{}: {} samples", channel.name, channel.samples.len());
  }
  
  provider.remove_audio(drums_file)?;
  ```
end note

' ============================================
' CACHING STRATEGY
' ============================================
package "Optional Caching" #Lavender {
    component "Decoded Frame Cache (LRU)" as frame_cache
    component "Recent FrameData Cache" as data_cache
}

frame_decoder --> frame_cache : "cache raw frames"
buffer_mgr --> data_cache : "cache FrameData"

note right of frame_cache
  Cache recently decoded frames:
  • Avoid re-decompression
  • Small cache (10-20 frames)
  • ~2-3MB for 240×180
end note

note right of data_cache
  Cache recent FrameData:
  • Avoid re-processing
  • Tiny cache (2-5 frames)
  • For repeated requests
  • ~1MB overhead
end note

@enduml

